                try {
                    this.achievements = new Set(JSON.parse(savedAchievements));
                } catch (e) {
                    console.warn('Could not parse achievements:', e);
                    this.achievements = new Set();
                }
            }
        } catch (e) {
            console.warn('Could not load game state from localStorage:', e);
            this.highScore = 0;
            this.achievements = new Set();
        }
    }
};

const UI = {
    power: 100,
    openApps: new Set(),
    tickInterval: null,
    timeInterval: null,
    
    init() {
        try {
            if (typeof World3D !== 'undefined') {
                World3D.init();
            }
            if (typeof Terminal !== 'undefined') {
                Terminal.init();
            }
            this.tickInterval = setInterval(() => this.tick(), 1000);
            this.timeInterval = setInterval(() => this.updateTime(), 1000);
            
            this.mouseMoveHandler = (e) => WindowManager.handleDrag(e);
            this.mouseUpHandler = () => WindowManager.endDrag();
            window.addEventListener('mousemove', this.mouseMoveHandler);
            window.addEventListener('mouseup', this.mouseUpHandler);
            
            // Cleanup on page unload
            window.addEventListener('beforeunload', () => this.cleanup());
            
            this.updateStats();
            this.updateButtons();
            
            // Keyboard shortcuts
            window.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    this.closeUpdatePopup();
                    // Pause/unpause games
                    if (typeof Snake !== 'undefined' && Snake.isRunning) Snake.togglePause();
                    if (typeof Pong !== 'undefined' && Pong.isRunning) Pong.togglePause();
                    if (typeof Dodge !== 'undefined' && Dodge.isRunning) Dodge.togglePause();
                }
                // Quick app shortcuts
                if (e.ctrlKey || e.metaKey) {
                    if (e.key === '1') { e.preventDefault(); this.toggle('snake'); }
                    if (e.key === '2') { e.preventDefault(); this.toggle('pong'); }
                    if (e.key === '3') { e.preventDefault(); this.toggle('dodge'); }
                    if (e.key === 't') { e.preventDefault(); this.toggle('term'); }
                }
            });
        } catch (error) {
            console.error('Error initializing UI:', error);
        }
    },
    
    cleanup() {
        if (this.tickInterval) clearInterval(this.tickInterval);
        if (this.timeInterval) clearInterval(this.timeInterval);
        if (this.mouseMoveHandler) window.removeEventListener('mousemove', this.mouseMoveHandler);
        if (this.mouseUpHandler) window.removeEventListener('mouseup', this.mouseUpHandler);
        
        // Cleanup game timers
        if (typeof Snake !== 'undefined' && Snake.timer) clearInterval(Snake.timer);
        if (typeof Pong !== 'undefined' && Pong.timer) clearInterval(Pong.timer);
        if (typeof Dodge !== 'undefined' && Dodge.timer) clearInterval(Dodge.timer);
    },

    tick() {
        try {
            const drainRate = (this.openApps.size * 0.15) + 0.08;
            this.power = Math.max(0, this.power - drainRate);
            
            // Shield regeneration
            if (GameState.shield < 100) {
                GameState.shield = Math.min(100, GameState.shield + 0.5);
            }
            
            const batFill = document.getElementById('bat-fill');
            const shieldFill = document.getElementById('shield-fill');
            const drainRateEl = document.getElementById('drain-rate');
            const comboEl = document.getElementById('combo-ui');
            
            if (batFill) {
                const oldPower = parseFloat(batFill.style.width) || 100;
                batFill.style.width = this.power + "%";
                batFill.classList.remove('warning', 'critical');
                if (this.power <= 25) {
                    batFill.classList.add('critical');
                    if (oldPower > 25) SoundManager.playWarning();
                } else if (this.power <= 50) {
                    batFill.classList.add('warning');
                    if (oldPower > 50) SoundManager.playBeep(400, 0.1);
                }
            }
            
            if (shieldFill) shieldFill.style.width = GameState.shield + "%";
            if (drainRateEl) drainRateEl.textContent = drainRate.toFixed(2);
            if (comboEl) comboEl.textContent = GameState.combo.toFixed(1);
            
            // Combo decay
            if (GameState.combo > 1.0) {
                GameState.combo = Math.max(1.0, GameState.combo - 0.05);
            }
            
            if (this.power <= 0 && World3D.isLive && !World3D.escapeMode) {
                World3D.fail("BATTERY DEPLETED");
            }
            
            // Win condition: Survive 300 seconds (5 minutes)
            if (GameState.survivalTime >= 300 && World3D.isLive && !World3D.escapeMode) {
                World3D.win();
            }
            
            // Alternative win: Push entity back to 60m and keep it there
            if (World3D.dist >= 60 && World3D.isLive && !World3D.escapeMode) {
                World3D.entityPushBackTime++;
                if (World3D.entityPushBackTime >= 30) { // 30 seconds at max distance
                    World3D.win();
                }
            } else {
                World3D.entityPushBackTime = 0;
            }
        } catch (error) {
            console.error('Error in UI.tick:', error);
        }
    },

    updateTime() {
        try {
            GameState.survivalTime++;
            const timeUI = document.getElementById('time-ui');
            if (timeUI) timeUI.textContent = GameState.survivalTime;
            
            // Achievement checks
            this.checkAchievements();
        } catch (error) {
            console.error('Error in updateTime:', error);
        }
    },

    toggle(id) {
        const win = document.getElementById(`win-${id}`);
        if (win.style.display === 'flex') {
            win.style.display = 'none';
            this.openApps.delete(id);
            SoundManager.playClick();
        } else {
            win.style.display = 'flex';
            this.openApps.add(id);
            WindowManager.bringToFront(win);
            SoundManager.playBeep(600, 0.08);
        }
        this.updateStats();
        this.updateButtons();
    },

    updateStats() {
        const procCount = document.getElementById('proc-count');
        if (procCount) procCount.textContent = this.openApps.size;
    },

    updateButtons() {
        document.querySelectorAll('.sys-btn[data-app]').forEach(btn => {
            const app = btn.getAttribute('data-app');
            if (this.openApps.has(app)) {
                btn.classList.add('active');
            } else {
                btn.classList.remove('active');
            }
        });
    },

    showPowerup(text) {
        const notify = document.getElementById('powerup-notify');
        if (!notify) return;
        
        notify.textContent = text;
        notify.style.display = 'block';
        SoundManager.playPowerup();
        
        // Clear any existing timeout
        if (this.powerupTimeout) clearTimeout(this.powerupTimeout);
        this.powerupTimeout = setTimeout(() => {
            notify.style.display = 'none';
        }, 2000);
    },

    showNotification(text, duration = 3000) {
        const notification = document.getElementById('notification');
        if (!notification) return;
        
        notification.textContent = text;
        notification.classList.add('show');
        
        if (this.notificationTimeout) clearTimeout(this.notificationTimeout);
        this.notificationTimeout = setTimeout(() => {
            notification.classList.remove('show');
        }, duration);
    },

    closeUpdatePopup() {
        const popup = document.getElementById('update-popup');
        const overlay = document.getElementById('popup-overlay');
        if (popup) popup.classList.remove('show');
        if (overlay) overlay.classList.remove('show');
        SoundManager.playClick();
    },

    checkAchievements() {
        const achievements = [
            { id: 'survive30', time: 30, text: 'First Blood - Survived 30s' },
            { id: 'survive60', time: 60, text: 'Veteran - Survived 60s' },
            { id: 'survive120', time: 120, text: 'Legend - Survived 120s' },
            { id: 'combo5', check: () => GameState.combo >= 5, text: 'Combo Master - 5x Multiplier' },
            { id: 'multitask', check: () => this.openApps.size >= 3, text: 'Multitasker - 3 Apps Open' },
            { id: 'snake10', check: () => typeof Snake !== 'undefined' && Snake.score >= 10, text: 'Snake Expert - 10 Points' },
            { id: 'pong20', check: () => typeof Pong !== 'undefined' && Pong.score >= 20, text: 'Pong Master - 20 Points' },
            { id: 'dodge50', check: () => typeof Dodge !== 'undefined' && Dodge.score >= 50, text: 'Dodge Legend - 50 Points' }
        ];

        achievements.forEach(ach => {
            if (GameState.achievements.has(ach.id)) return;
            
            let unlocked = false;
            if (ach.time && GameState.survivalTime >= ach.time) unlocked = true;
            if (ach.check && ach.check()) unlocked = true;
            
            if (unlocked) {
                GameState.achievements.add(ach.id);
                this.showPowerup('🏆 ' + ach.text);
                this.updateAchievementPanel();
                SoundManager.playSuccess();
                try {
                    localStorage.setItem('voidOsAchievements', JSON.stringify([...GameState.achievements]));
                } catch (e) {
                    console.warn('Could not save achievements:', e);
                }
            }
        });
    },

    updateAchievementPanel() {
        const panel = document.getElementById('achievement-panel');
        const list = document.getElementById('achievement-list');
        list.innerHTML = [...GameState.achievements].map(a => `✓ ${a}`).join('<br>');
        if (GameState.achievements.size > 0) {
            panel.style.display = 'block';
        }
    }
};

