// GAME: NEURAL_SNAKE
// =============================================================================

const Snake = {
    ctx: null, 
    snake: [], 
    dir: {x:1, y:0}, 
    apple: {x:5, y:5}, 
    timer: null,
    score: 0,
    gridSize: 20,
    cellSize: 15,
    isRunning: false,
    isPaused: false,

    start() {
        const canvas = document.getElementById('can-snake');
        if (!canvas) return;
        
        this.ctx = canvas.getContext('2d');
        if (!this.ctx) return;
        
        this.snake = [{x:10, y:10}]; 
        this.dir = {x:1, y:0};
        this.score = 0;
        this.isPaused = false;
        this.isRunning = true;
        this.spawnApple();
        this.updateScore();
        SoundManager.playBeep(500, 0.1);
        
        // Remove old listener if exists
        if (this.keyHandler) {
            window.removeEventListener('keydown', this.keyHandler);
        }
        this.keyHandler = (e) => {
            if (e.key === ' ') {
                e.preventDefault();
                this.togglePause();
            } else {
                this.handleInput(e);
            }
        };
        window.addEventListener('keydown', this.keyHandler);
        
        if (this.timer) clearInterval(this.timer);
        this.timer = setInterval(() => this.loop(), 100);
    },

    togglePause() {
        if (!this.isRunning) return;
        this.isPaused = !this.isPaused;
        const pauseEl = document.getElementById('snake-pause');
        if (pauseEl) {
            pauseEl.classList.toggle('show', this.isPaused);
        }
        SoundManager.playClick();
    },

    handleInput(e) {
        const key = e.key;
        if (key === 'ArrowUp' && this.dir.y === 0) this.dir = {x:0, y:-1};
        else if (key === 'ArrowDown' && this.dir.y === 0) this.dir = {x:0, y:1};
        else if (key === 'ArrowLeft' && this.dir.x === 0) this.dir = {x:-1, y:0};
        else if (key === 'ArrowRight' && this.dir.x === 0) this.dir = {x:1, y:0};
    },

    spawnApple() {
        let validPosition = false;
        while (!validPosition) {
            this.apple = {
                x: Math.floor(Math.random() * this.gridSize), 
                y: Math.floor(Math.random() * this.gridSize)
            };
            validPosition = !this.snake.some(seg => seg.x === this.apple.x && seg.y === this.apple.y);
        }
    },

    loop() {
        if (!UI.openApps.has('snake') || !this.isRunning || this.isPaused) return;
        
        const head = {
            x: this.snake[0].x + this.dir.x, 
            y: this.snake[0].y + this.dir.y
        };

        if (this.snake.some(seg => seg.x === head.x && seg.y === head.y)) {
            this.isRunning = false;
            this.isPaused = false;
            const pauseEl = document.getElementById('snake-pause');
            if (pauseEl) pauseEl.classList.remove('show');
            SoundManager.playError();
            this.start();
            return;
        }

        if (head.x < 0 || head.x >= this.gridSize || head.y < 0 || head.y >= this.gridSize) {
            this.isRunning = false;
            this.isPaused = false;
            const pauseEl = document.getElementById('snake-pause');
            if (pauseEl) pauseEl.classList.remove('show');
            SoundManager.playError();
            this.start();
            return;
        }

        if (head.x === this.apple.x && head.y === this.apple.y) {
            this.score++;
            this.updateScore();
            this.spawnApple();
            SoundManager.playCollect();
            if (typeof World3D !== 'undefined' && World3D.pushBack) {
                World3D.pushBack(5);
            }
            if (typeof UI !== 'undefined') {
                UI.power = Math.min(100, UI.power + 2);
            }
        } else {
            this.snake.pop();
        }

        this.snake.unshift(head);
        this.draw();
    },

    draw() {
        this.ctx.fillStyle = '#000';
        this.ctx.fillRect(0, 0, 300, 300);
        
        this.ctx.fillStyle = '#3f0';
        this.snake.forEach((seg, i) => {
            const brightness = 1 - (i / this.snake.length) * 0.5;
            this.ctx.globalAlpha = brightness;
            this.ctx.fillRect(seg.x * this.cellSize, seg.y * this.cellSize, this.cellSize - 1, this.cellSize - 1);
        });
        this.ctx.globalAlpha = 1;
        
        this.ctx.fillStyle = '#f00';
        this.ctx.fillRect(this.apple.x * this.cellSize, this.apple.y * this.cellSize, this.cellSize - 1, this.cellSize - 1);
    },

    updateScore() {
        const scoreEl = document.getElementById('snake-score');
        if (scoreEl) scoreEl.textContent = this.score;
    }
};

// =============================================================================
// GAME: PONG
// =============================================================================

const Pong = {
    ctx: null, 
    ball: {x:200, y:110, dx:4, dy:4}, 
    paddleY: 80, 
    aiPaddleY: 80,
    timer: null,
    score: 0,
    paddleHeight: 60,
    paddleWidth: 10,
    isRunning: false,
    isPaused: false,

    start() {
        const canvas = document.getElementById('can-pong');
        if (!canvas) return;
        
        this.ctx = canvas.getContext('2d');
        if (!this.ctx) return;
        
        this.score = 0;
        this.ball = {x:200, y:110, dx:4, dy:4};
        this.isPaused = false;
        this.isRunning = true;
        this.updateScore();
        SoundManager.playBeep(500, 0.1);
        
        // Remove old listener if exists
        if (this.mouseHandler) {
            canvas.removeEventListener('mousemove', this.mouseHandler);
        }
        this.mouseHandler = (e) => {
            if (this.isPaused) return;
            const rect = canvas.getBoundingClientRect();
            this.paddleY = Math.max(0, Math.min(e.clientY - rect.top - this.paddleHeight/2, 220 - this.paddleHeight));
        };
        canvas.addEventListener('mousemove', this.mouseHandler);
        
        if (this.keyHandler) {
            window.removeEventListener('keydown', this.keyHandler);
        }
        this.keyHandler = (e) => {
            if (e.key === ' ' && UI.openApps.has('pong')) {
                e.preventDefault();
                this.togglePause();
            }
        };
        window.addEventListener('keydown', this.keyHandler);
        
        if (this.timer) clearInterval(this.timer);
        this.timer = setInterval(() => this.loop(), 16);
    },

    togglePause() {
        if (!this.isRunning) return;
        this.isPaused = !this.isPaused;
        const pauseEl = document.getElementById('pong-pause');
        if (pauseEl) {
            pauseEl.classList.toggle('show', this.isPaused);
        }
        SoundManager.playClick();
    },

    loop() {
        if (!UI.openApps.has('pong') || !this.isRunning || this.isPaused) return;
        
        this.ball.x += this.ball.dx;
        this.ball.y += this.ball.dy;
        
        if (this.ball.y <= 0 || this.ball.y >= 212) {
            this.ball.dy *= -1;
        }
        
        if (this.ball.x <= 15 && 
            this.ball.y >= this.paddleY && 
            this.ball.y <= this.paddleY + this.paddleHeight) {
            this.ball.dx = Math.abs(this.ball.dx) * 1.05;
            this.ball.dy += (this.ball.y - (this.paddleY + this.paddleHeight/2)) * 0.1;
            this.score++;
            this.updateScore();
            SoundManager.playHit();
            if (typeof World3D !== 'undefined' && World3D.pushBack) {
                World3D.pushBack(3);
            }
            if (typeof UI !== 'undefined') {
                UI.power = Math.min(100, UI.power + 1);
            }
        }
        
        if (this.ball.x >= 385 && 
            this.ball.y >= this.aiPaddleY && 
            this.ball.y <= this.aiPaddleY + this.paddleHeight) {
            this.ball.dx = -Math.abs(this.ball.dx);
        }
        
        const aiSpeed = 3;
        if (this.ball.y < this.aiPaddleY + this.paddleHeight/2) {
            this.aiPaddleY = Math.max(0, this.aiPaddleY - aiSpeed);
        } else {
            this.aiPaddleY = Math.min(220 - this.paddleHeight, this.aiPaddleY + aiSpeed);
        }
        
        if (this.ball.x < 0 || this.ball.x > 400) {
            this.ball = {x:200, y:110, dx:4, dy:4};
        }
        
        this.draw();
    },

    draw() {
        this.ctx.fillStyle = '#000';
        this.ctx.fillRect(0, 0, 400, 220);
        
        this.ctx.strokeStyle = '#0a4d0a';
        this.ctx.setLineDash([5, 5]);
        this.ctx.beginPath();
        this.ctx.moveTo(200, 0);
        this.ctx.lineTo(200, 220);
        this.ctx.stroke();
        this.ctx.setLineDash([]);
        
        this.ctx.fillStyle = '#3f0';
        this.ctx.fillRect(5, this.paddleY, this.paddleWidth, this.paddleHeight);
        
        this.ctx.fillStyle = '#f00';
        this.ctx.fillRect(385, this.aiPaddleY, this.paddleWidth, this.paddleHeight);
        
        this.ctx.fillStyle = '#3f0';
        this.ctx.fillRect(this.ball.x, this.ball.y, 8, 8);
    },

    updateScore() {
        const scoreEl = document.getElementById('pong-score');
        if (scoreEl) scoreEl.textContent = this.score;
    }
};

// =============================================================================
// GAME: DODGE (NEW!)
// =============================================================================

const Dodge = {
    ctx: null,
    player: {x: 150, y: 360, w: 20, h: 20},
    obstacles: [],
    timer: null,
    score: 0,
    lives: 3,
    spawnRate: 60,
    frameCount: 0,
    isRunning: false,
    isPaused: false,

    start() {
        const canvas = document.getElementById('can-dodge');
        if (!canvas) return;
        
        this.ctx = canvas.getContext('2d');
        if (!this.ctx) return;
        
        this.player = {x: 150, y: 360, w: 20, h: 20};
        this.obstacles = [];
        this.score = 0;
        this.lives = 3;
        this.frameCount = 0;
        this.isPaused = false;
        this.isRunning = true;
        this.updateScore();
        SoundManager.playBeep(500, 0.1);
        
        // Remove old listener if exists
        if (this.mouseHandler) {
            canvas.removeEventListener('mousemove', this.mouseHandler);
        }
        this.mouseHandler = (e) => {
            if (this.isPaused) return;
            const rect = canvas.getBoundingClientRect();
            this.player.x = Math.max(0, Math.min(e.clientX - rect.left - this.player.w/2, 300 - this.player.w));
        };
        canvas.addEventListener('mousemove', this.mouseHandler);
        
        if (this.keyHandler) {
            window.removeEventListener('keydown', this.keyHandler);
        }
        this.keyHandler = (e) => {
            if (e.key === ' ' && UI.openApps.has('dodge')) {
                e.preventDefault();
                this.togglePause();
            }
        };
        window.addEventListener('keydown', this.keyHandler);
        
        if (this.timer) clearInterval(this.timer);
        this.timer = setInterval(() => this.loop(), 16);
    },

    togglePause() {
        if (!this.isRunning) return;
        this.isPaused = !this.isPaused;
        const pauseEl = document.getElementById('dodge-pause');
        if (pauseEl) {
            pauseEl.classList.toggle('show', this.isPaused);
        }
        SoundManager.playClick();
    },

    loop() {
        if (!UI.openApps.has('dodge') || !this.isRunning || this.isPaused) return;
        
        this.frameCount++;
        
        if (this.frameCount % this.spawnRate === 0) {
            this.obstacles.push({
                x: Math.random() * 280,
                y: -20,
                w: 15 + Math.random() * 25,
                h: 15 + Math.random() * 25,
                speed: 2 + Math.random() * 3
            });
        }
        
        this.obstacles.forEach((obs, i) => {
            obs.y += obs.speed;
            
            if (this.checkCollision(this.player, obs)) {
                this.lives--;
                this.updateScore();
                this.obstacles.splice(i, 1);
                SoundManager.playError();
                
                if (this.lives <= 0) {
                    if (typeof UI !== 'undefined' && UI.showPowerup) {
                        UI.showPowerup('💀 DODGE FAILED!');
                    }
                    this.isRunning = false;
                    this.isPaused = false;
                    const pauseEl = document.getElementById('dodge-pause');
                    if (pauseEl) pauseEl.classList.remove('show');
                    this.start();
                }
            }
            
            if (obs.y > 400) {
                this.obstacles.splice(i, 1);
                this.score++;
                this.updateScore();
                SoundManager.playCollect();
                if (typeof World3D !== 'undefined' && World3D.pushBack) {
                    World3D.pushBack(2);
                }
                
                if (this.spawnRate > 20) {
                    this.spawnRate--;
                }
            }
        });
        
        this.draw();
    },

    checkCollision(a, b) {
        return a.x < b.x + b.w &&
               a.x + a.w > b.x &&
               a.y < b.y + b.h &&
               a.y + a.h > b.y;
    },

    draw() {
        this.ctx.fillStyle = '#000';
        this.ctx.fillRect(0, 0, 300, 400);
        
        this.ctx.fillStyle = '#3f0';
        this.ctx.fillRect(this.player.x, this.player.y, this.player.w, this.player.h);
        
        this.ctx.fillStyle = '#f00';
        this.obstacles.forEach(obs => {
            this.ctx.fillRect(obs.x, obs.y, obs.w, obs.h);
        });
    },

    updateScore() {
        const scoreEl = document.getElementById('dodge-score');
        const livesEl = document.getElementById('dodge-lives');
        if (scoreEl) scoreEl.textContent = this.score;
        if (livesEl) livesEl.textContent = this.lives;
    }
};

// =============================================================================
// INITIALIZATION
// =============================================================================

window.onload = () => {
    try {
        // Initialize sound system first
        if (typeof SoundManager !== 'undefined' && SoundManager.init) {
            SoundManager.init();
        }
        
        // Show update popup
        const updatePopup = document.getElementById('update-popup');
        const overlay = document.getElementById('popup-overlay');
        if (updatePopup && overlay) {
            updatePopup.classList.add('show');
            overlay.classList.add('show');
            // Auto-close after 10 seconds
            setTimeout(() => {
                if (updatePopup.classList.contains('show')) {
                    UI.closeUpdatePopup();
                }
            }, 10000);
        }
        
        // Initialize game state first
        if (typeof GameState !== 'undefined' && GameState.init) {
            GameState.init();
        }
        
        // Then initialize UI
        if (typeof UI !== 'undefined') {
            UI.init();
            UI.updateAchievementPanel();
        }
        
        // Initialize audio context on first user interaction
        document.addEventListener('click', () => {
            if (SoundManager && !SoundManager.audioContext) {
                SoundManager.getContext();
            }
        }, { once: true });
    } catch (error) {
        console.error('Error initializing application:', error);
        const errorMsg = document.createElement('div');
        errorMsg.style.cssText = 'position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(0,0,0,0.9);color:var(--p-red);padding:20px;border:2px solid var(--p-red);z-index:99999;';
        errorMsg.textContent = 'Failed to initialize. Please refresh the page.';
        document.body.appendChild(errorMsg);
    }
};
