const GameState = {
    highScore: 0,
    survivalTime: 0,
    combo: 1.0,
    shield: 100,
    achievements: new Set(),
    
    init() {
        try {
            this.highScore = parseInt(localStorage.getItem('voidOsHighScore') || '0') || 0;
