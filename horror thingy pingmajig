    stalkerCore: null,
    stalkerAura: null,
    stalkerTendrils: [],
    stalkerLight: null,
    particles: [],
    dist: 60, 
    isLive: true,
    warningThreshold: 12,
    criticalThreshold: 5,
    frameCount: 0,
    escapeMode: false,
    escapeScene: null,
    playerPosition: {x: 0, y: 1.7, z: 0},
    playerVelocity: {x: 0, y: 0, z: 0},
    playerRotation: {x: 0, y: 0},
    keys: {},
    exitDoor: null,
    winTime: 0,
    entityPushBackTime: 0,

    init() {
        if (typeof THREE === 'undefined') {
            console.error('Three.js not loaded. 3D features disabled.');
            this.isLive = false;
            return;
        }
        
        try {
            this.scene = new THREE.Scene();
            this.scene.fog = new THREE.FogExp2(0x000000, 0.12);
            
            this.camera = new THREE.PerspectiveCamera(75, window.innerWidth/window.innerHeight, 0.1, 1000);
            this.camera.position.set(0, 1.7, 5);

            this.renderer = new THREE.WebGLRenderer({ antialias: false });
            this.renderer.setSize(window.innerWidth, window.innerHeight);
            const canvasContainer = document.getElementById('world-canvas');
            if (canvasContainer) {
                canvasContainer.appendChild(this.renderer.domElement);
            }

            // Corridor - darker, more menacing
            const corridorGeo = new THREE.BoxGeometry(10, 5, 200);
            const corridorMat = new THREE.MeshStandardMaterial({ 
                color: 0x050505, 
                wireframe: true,
                transparent: true,
                opacity: 0.5
            });
            const corridor = new THREE.Mesh(corridorGeo, corridorMat);
            corridor.position.z = -90;
            this.scene.add(corridor);

            // Stalker entity - enhanced horror design
            this.stalker = new THREE.Group();
            
            // Core body - larger, darker, more menacing
            const core = new THREE.Mesh(
                new THREE.IcosahedronGeometry(1.2, 2),
                new THREE.MeshBasicMaterial({ 
                    color: 0x330000,
                    wireframe: false
                })
            );
            this.stalker.add(core);
            
            // Inner dark core - void-like center
            const voidCore = new THREE.Mesh(
                new THREE.SphereGeometry(0.4, 16, 16),
                new THREE.MeshBasicMaterial({ 
                    color: 0x000000,
                    wireframe: false
                })
            );
            this.stalker.add(voidCore);
            
            // Glowing eyes - more menacing, larger
            const eyeGeo = new THREE.SphereGeometry(0.2, 12, 12);
            const eyeMat = new THREE.MeshBasicMaterial({ 
                color: 0xff0000,
                emissive: 0xff0000,
                emissiveIntensity: 2
            });
            
            const eye1 = new THREE.Mesh(eyeGeo, eyeMat);
            eye1.position.set(-0.4, 0.4, 0.8);
            this.stalker.add(eye1);
            
            const eye2 = new THREE.Mesh(eyeGeo, eyeMat);
            eye2.position.set(0.4, 0.4, 0.8);
            this.stalker.add(eye2);
            
            // Third eye in center - more disturbing
            const eye3 = new THREE.Mesh(eyeGeo, eyeMat);
            eye3.position.set(0, 0.5, 0.8);
            eye3.scale.set(0.7, 0.7, 0.7);
            this.stalker.add(eye3);
            
            // More spiky tendrils - increased count and size
            for (let i = 0; i < 12; i++) {
                const tendril = new THREE.Mesh(
                    new THREE.ConeGeometry(0.12, 2.0, 6),
                    new THREE.MeshBasicMaterial({ 
                        color: 0x440000,
                        emissive: 0x220000
                    })
                );
                const angle = (i / 12) * Math.PI * 2;
                tendril.position.set(Math.cos(angle) * 0.8, Math.sin(angle) * 0.8, -0.5);
                tendril.rotation.set(Math.random() * 0.5, Math.random() * 0.5, Math.random() * 0.5);
                this.stalker.add(tendril);
            }
            
            // Jagged spikes around the body
            for (let i = 0; i < 16; i++) {
                const spike = new THREE.Mesh(
                    new THREE.ConeGeometry(0.08, 0.6, 4),
                    new THREE.MeshBasicMaterial({ color: 0x660000 })
                );
                const angle = (i / 16) * Math.PI * 2;
                const height = Math.sin(angle * 2) * 0.3;
                spike.position.set(Math.cos(angle) * 1.0, height, Math.sin(angle) * 0.3);
                spike.rotation.z = angle;
                this.stalker.add(spike);
            }
            
            // Outer glow/aura - darker, more intense
            const aura = new THREE.Mesh(
                new THREE.SphereGeometry(1.8, 16, 16),
                new THREE.MeshBasicMaterial({ 
                    color: 0x660000,
                    transparent: true,
                    opacity: 0.25,
                    wireframe: true
                })
            );
            this.stalker.add(aura);
            
            // Additional dark energy field
            const energyField = new THREE.Mesh(
                new THREE.SphereGeometry(2.2, 20, 20),
                new THREE.MeshBasicMaterial({ 
                    color: 0x000000,
                    transparent: true,
                    opacity: 0.4,
                    wireframe: true,
                    side: THREE.DoubleSide
                })
            );
            this.stalker.add(energyField);
            
            this.scene.add(this.stalker);
            this.stalkerCore = core;
            this.stalkerAura = aura;
            this.stalkerTendrils = this.stalker.children.filter(c => 
                c.geometry?.type === 'ConeGeometry' && c.position.z < 0
            );

            // Ambient particles - darker, more ominous
            for (let i = 0; i < 50; i++) {
                const particle = new THREE.Mesh(
                    new THREE.BoxGeometry(0.1, 0.1, 0.1),
                    new THREE.MeshBasicMaterial({ 
                        color: 0x001100,
                        emissive: 0x000000
                    })
                );
                particle.position.set(
                    (Math.random() - 0.5) * 20,
                    Math.random() * 5,
                    -Math.random() * 100
                );
                this.particles.push(particle);
                this.scene.add(particle);
            }
            
            // Dark energy particles near stalker
            for (let i = 0; i < 20; i++) {
                const darkParticle = new THREE.Mesh(
                    new THREE.SphereGeometry(0.05, 6, 6),
                    new THREE.MeshBasicMaterial({ 
                        color: 0x330000,
                        emissive: 0x110000,
                        emissiveIntensity: 0.5
                    })
                );
                darkParticle.position.set(
                    (Math.random() - 0.5) * 3,
                    (Math.random() - 0.5) * 3,
                    -this.dist + (Math.random() - 0.5) * 2
                );
                this.particles.push(darkParticle);
                this.scene.add(darkParticle);
            }

            // Ambient light - darker, more ominous
            const ambient = new THREE.AmbientLight(0x001100, 0.2);
            this.scene.add(ambient);
            
            // Red glow from stalker
            const stalkerLight = new THREE.PointLight(0x660000, 0.5, 30);
            stalkerLight.position.set(0, 1.4, -this.dist);
            this.scene.add(stalkerLight);
            
            // Store light reference for animation
            this.stalkerLight = stalkerLight;
            
            // Initialize escape mode variables
            this.escapeMode = false;
            this.keys = {};
            this.entityPushBackTime = 0;

            window.addEventListener('resize', () => this.onResize());
            
            this.animate();
        } catch (error) {
            console.error('Error initializing 3D world:', error);
            this.isLive = false;
        }
    },

    onResize() {
        if (this.camera) {
            this.camera.aspect = window.innerWidth / window.innerHeight;
            this.camera.updateProjectionMatrix();
        }
        if (this.renderer) {
            this.renderer.setSize(window.innerWidth, window.innerHeight);
        }
    },

    animate() {
        if (this.escapeMode) return; // Don't run main animation in escape mode
        if (!this.isLive || !this.renderer || !this.scene || !this.camera) return;
        requestAnimationFrame(() => this.animate());

        // Only update distance if not in escape mode
        if (!this.escapeMode) {
            const speed = UI.openApps.size > 0 ? 0.02 : 0.008;
            this.dist -= speed;
        }
        
        // Stalker movement with more disturbing, erratic animations (only if stalker exists)
        if (this.stalker) {
            const time = Date.now() * 0.002;
            const proximity = Math.max(0, 1 - (this.dist / 60));
            
            // More erratic, jerky movement
            this.stalker.position.set(
                Math.sin(time) * 2.5 + Math.sin(time * 7) * 0.5, 
                1.4 + Math.sin(time * 4) * 0.6 + Math.cos(time * 6) * 0.3, 
                -this.dist
            );
            
            // Core pulsating - more intense, irregular
            if (this.stalkerCore) {
                const pulse = 1 + Math.sin(time * 6) * 0.2 + Math.sin(time * 13) * 0.1;
                this.stalkerCore.scale.set(pulse, pulse * 1.1, pulse);
            }
            
            // More erratic, disturbing rotation
            this.stalker.rotation.x += 0.04 + Math.sin(time * 3) * 0.02;
            this.stalker.rotation.y += 0.06 + Math.cos(time * 5) * 0.02;
            this.stalker.rotation.z = Math.sin(time * 2) * 0.1;
            
            // Tendrils writhing more violently
            this.stalkerTendrils.forEach((tendril, i) => {
                tendril.rotation.z = Math.sin(time * 4 + i) * 0.8;
                tendril.rotation.x = Math.cos(time * 3 + i * 0.5) * 0.4;
                tendril.scale.y = 1 + Math.sin(time * 5 + i * 0.5) * 0.4;
                // Make tendrils reach out more when close
                if (proximity > 0.5) {
                    tendril.scale.y *= (1 + proximity * 0.3);
                }
            });
            
            // Aura intensity based on proximity - more dramatic
            if (this.stalkerAura) {
                const intensity = Math.max(0.2, proximity);
                this.stalkerAura.material.opacity = intensity * 0.4;
                this.stalkerAura.rotation.y += 0.03;
                this.stalkerAura.rotation.x += 0.01;
            }
            
            // Energy field pulsing
            const energyField = this.stalker.children.find(c => c.geometry?.type === 'SphereGeometry' && c.material?.opacity === 0.4);
            if (energyField) {
                energyField.rotation.y -= 0.02;
                energyField.rotation.z += 0.015;
                energyField.material.opacity = 0.3 + Math.sin(time * 8) * 0.15;
            }
        }
        
        // Update stalker light position and intensity (only if stalker exists)
        if (this.stalkerLight && this.stalker) {
            this.stalkerLight.position.set(
                this.stalker.position.x,
                this.stalker.position.y,
                this.stalker.position.z
            );
            const lightIntensity = 0.3 + proximity * 0.7 + Math.sin(time * 5) * 0.2;
            this.stalkerLight.intensity = lightIntensity;
        }
        
        // Eyes glowing more intensely when close (only if stalker exists)
        if (this.stalker) {
            const eyes = this.stalker.children.filter(c => c.material?.emissive);
            eyes.forEach((eye, i) => {
                const glow = 2 + proximity * 3 + Math.sin(time * 10 + i) * 0.5;
                eye.material.emissiveIntensity = glow;
                // Eyes track player (subtle movement)
                if (i < 3) {
                    eye.rotation.y = Math.sin(time * 2 + i) * 0.2;
                }
            });
            
            // Spikes twitching
            const spikes = this.stalker.children.filter(c => c.geometry?.type === 'ConeGeometry' && c.position.y < 0.5);
            spikes.forEach((spike, i) => {
                spike.rotation.z += 0.05 + Math.sin(time * 7 + i) * 0.03;
                spike.scale.y = 1 + Math.sin(time * 6 + i * 0.3) * 0.2;
            });
        }

        // Update UI (only if not in escape mode)
        if (!this.escapeMode) {
            const displayDist = Math.max(0, Math.floor(this.dist));
            const distUI = document.getElementById('dist-ui');
            if (distUI) distUI.innerText = displayDist;
        }

        // Warning states with scary sounds (only if not in escape mode)
        if (!this.escapeMode) {
            const warning = document.getElementById('warning');
            if (warning) {
                const wasVisible = warning.style.display === 'block';
                if (this.dist < this.criticalThreshold) {
                    warning.style.display = 'block';
                    warning.classList.add('glitch');
                    if (!wasVisible) {
                        if (typeof SoundManager !== 'undefined' && SoundManager.playEntityNear) {
                            SoundManager.playEntityNear();
                        }
                    } else if (this.frameCount % 60 === 0) {
                        // Play menacing sound periodically when very close
                        if (typeof SoundManager !== 'undefined' && SoundManager.playEntityApproach) {
                            SoundManager.playEntityApproach();
                        }
                    }
                } else if (this.dist < this.warningThreshold) {
                    warning.style.display = 'block';
                    warning.classList.remove('glitch');
                    if (!wasVisible) {
                        if (typeof SoundManager !== 'undefined' && SoundManager.playEntityApproach) {
                            SoundManager.playEntityApproach();
                        }
                    } else if (this.frameCount % 120 === 0) {
                        // Occasional warning when approaching
                        if (typeof SoundManager !== 'undefined' && SoundManager.playWarning) {
                            SoundManager.playWarning();
                        }
                    }
                } else {
                    warning.style.display = 'none';
                }
            }
        }

        // Particle animation (throttled for performance) - only if not in escape mode
        if (!this.escapeMode) {
            this.frameCount = (this.frameCount || 0) + 1;
            if (this.frameCount % 2 === 0) {
                this.particles.forEach((p, i) => {
                    if (i < 50) {
                        // Regular particles
                        p.position.z += 0.2;
                        if (p.position.z > 5) p.position.z = -100;
                        p.rotation.x += 0.02;
                        p.rotation.y += 0.02;
                    } else {
                        // Dark energy particles around stalker
                        const offset = i - 50;
                        const angle = (time * 2 + offset * 0.3) % (Math.PI * 2);
                        p.position.x = this.stalker.position.x + Math.cos(angle) * (1.5 + Math.sin(time * 3) * 0.3);
                        p.position.y = this.stalker.position.y + Math.sin(angle * 2) * 0.8;
                        p.position.z = this.stalker.position.z + Math.sin(angle) * 0.5;
                        p.rotation.x += 0.05;
                        p.rotation.y += 0.05;
                        // Pulsing glow
                        if (p.material.emissiveIntensity !== undefined) {
                            p.material.emissiveIntensity = 0.3 + Math.sin(time * 8 + offset) * 0.3;
                        }
                    }
                });
            }
        }

        // Death condition with shield (only if not in escape mode)
        if (!this.escapeMode && this.dist < 1.5) {
            if (GameState.shield > 0) {
                GameState.shield = 0;
                this.pushBack(20);
                UI.showPowerup('🛡️ SHIELD ABSORBED IMPACT!');
                if (typeof SoundManager !== 'undefined' && SoundManager.playHit) {
                    SoundManager.playHit();
                }
            } else {
                this.fail("ENTITY CONTACT");
            }
        }

        if (!this.escapeMode && this.renderer && this.scene && this.camera) {
            this.renderer.render(this.scene, this.camera);
        }
    },

    pushBack(amt) {
        this.dist = Math.min(60, this.dist + amt * GameState.combo);
        GameState.combo = Math.min(10, GameState.combo + 0.1);
    },

    win() {
        this.isLive = false;
        this.winTime = GameState.survivalTime;
        
        if (typeof SoundManager !== 'undefined' && SoundManager.playSuccess) {
            SoundManager.playSuccess();
        }
        
        // Hide desktop UI
        const desktop = document.getElementById('desktop');
        if (desktop) desktop.style.display = 'none';
        
        // Show win screen
        const winScreen = document.getElementById('win-screen');
        const winTimeEl = document.getElementById('win-time');
        if (winScreen) winScreen.style.display = 'flex';
        if (winTimeEl) winTimeEl.textContent = this.winTime;
        
        // Save high score
        if (this.winTime > GameState.highScore) {
            GameState.highScore = this.winTime;
            try {
                localStorage.setItem('voidOsHighScore', GameState.highScore);
            } catch (e) {
                console.warn('Could not save high score:', e);
            }
        }
    },

    startEscape() {
        this.escapeMode = true;
        this.isLive = false; // Stop main game loop
        const winScreen = document.getElementById('win-screen');
        if (winScreen) winScreen.style.display = 'none';
        
        // Hide desktop
        const desktop = document.getElementById('desktop');
        if (desktop) desktop.style.display = 'none';
        
        // Show escape HUD
        const escapeHud = document.getElementById('escape-hud');
        const escapeInstructions = document.getElementById('escape-instructions');
        if (escapeHud) escapeHud.style.display = 'block';
        if (escapeInstructions) escapeInstructions.style.display = 'block';
        
        // Initialize escape scene
        this.initEscapeScene();
        
        // Setup controls
        this.setupEscapeControls();
        
        // Start escape animation loop
        setTimeout(() => {
            this.animateEscape();
        }, 100);
        
        if (typeof SoundManager !== 'undefined' && SoundManager.playPowerup) {
            SoundManager.playPowerup();
        }
    },

    initEscapeScene() {
        if (typeof THREE === 'undefined') {
            console.error('Three.js not available for escape mode');
            return;
        }
        
        // Clear old scene
        if (this.scene) {
            while(this.scene.children.length > 0) {
                this.scene.remove(this.scene.children[0]);
            }
        } else {
            this.scene = new THREE.Scene();
        }
        
        this.scene.fog = new THREE.FogExp2(0x000000, 0.15);
        
        // First-person camera
        if (!this.camera) {
            this.camera = new THREE.PerspectiveCamera(75, window.innerWidth/window.innerHeight, 0.1, 1000);
        }
        this.camera.position.set(0, 1.7, 0);
        this.playerPosition = {x: 0, y: 1.7, z: 0};
        this.playerRotation = {x: 0, y: 0};
        
        // Ensure renderer exists
        if (!this.renderer) {
            this.renderer = new THREE.WebGLRenderer({ antialias: false });
            this.renderer.setSize(window.innerWidth, window.innerHeight);
            const canvasContainer = document.getElementById('world-canvas');
            if (canvasContainer) {
                canvasContainer.appendChild(this.renderer.domElement);
            }
        }
        
        // Basement floor
        const floorGeo = new THREE.PlaneGeometry(100, 100);
        const floorMat = new THREE.MeshStandardMaterial({ 
            color: 0x1a1a1a,
            roughness: 0.8
        });
        const floor = new THREE.Mesh(floorGeo, floorMat);
        floor.rotation.x = -Math.PI / 2;
        floor.position.y = 0;
        this.scene.add(floor);
        
        // Basement walls
        const wallMat = new THREE.MeshStandardMaterial({ 
            color: 0x0a0a0a,
            roughness: 0.9
        });
        
        // Back wall
        const backWall = new THREE.Mesh(
            new THREE.PlaneGeometry(100, 10),
            wallMat
        );
        backWall.position.set(0, 5, -50);
        this.scene.add(backWall);
        
        // Side walls
        const leftWall = new THREE.Mesh(
            new THREE.PlaneGeometry(100, 10),
            wallMat
        );
        leftWall.rotation.y = Math.PI / 2;
        leftWall.position.set(-50, 5, 0);
        this.scene.add(leftWall);
        
        const rightWall = new THREE.Mesh(
            new THREE.PlaneGeometry(100, 10),
            wallMat
        );
        rightWall.rotation.y = -Math.PI / 2;
        rightWall.position.set(50, 5, 0);
        this.scene.add(rightWall);
        
        // Ceiling
        const ceiling = new THREE.Mesh(
            new THREE.PlaneGeometry(100, 100),
            new THREE.MeshStandardMaterial({ color: 0x050505 })
        );
        ceiling.rotation.x = Math.PI / 2;
        ceiling.position.y = 10;
        this.scene.add(ceiling);
        
        // Basement pillars
        for (let i = 0; i < 8; i++) {
            const pillar = new THREE.Mesh(
                new THREE.CylinderGeometry(0.5, 0.5, 10, 8),
                new THREE.MeshStandardMaterial({ color: 0x151515 })
            );
            pillar.position.set(
                (Math.random() - 0.5) * 80,
                5,
                (Math.random() - 0.5) * 80
            );
            this.scene.add(pillar);
        }
        
        // Exit door - glowing green
        const doorFrame = new THREE.Mesh(
            new THREE.BoxGeometry(3, 4, 0.5),
            new THREE.MeshStandardMaterial({ color: 0x0a0a0a })
        );
        doorFrame.position.set(0, 2, 45);
        this.scene.add(doorFrame);
        
        const door = new THREE.Mesh(
            new THREE.PlaneGeometry(2.5, 3.5),
            new THREE.MeshStandardMaterial({ 
                color: 0x33ff00,
                emissive: 0x33ff00,
                emissiveIntensity: 2
            })
        );
        door.position.set(0, 2, 45.1);
        this.scene.add(door);
        this.exitDoor = door;
        
        // Exit sign above door
        const exitSign = new THREE.Mesh(
            new THREE.PlaneGeometry(2, 0.5),
            new THREE.MeshBasicMaterial({ 
                color: 0x33ff00,
                emissive: 0x33ff00,
                emissiveIntensity: 3
            })
        );
        exitSign.position.set(0, 4.5, 45);
        this.scene.add(exitSign);
        
        // Ambient light - very dark
        const ambient = new THREE.AmbientLight(0x001100, 0.1);
        this.scene.add(ambient);
        
        // Point lights for atmosphere
        for (let i = 0; i < 5; i++) {
            const light = new THREE.PointLight(0x003300, 0.3, 20);
            light.position.set(
                (Math.random() - 0.5) * 60,
                2,
                (Math.random() - 0.5) * 60
            );
            this.scene.add(light);
        }
        
        // Light near exit
        const exitLight = new THREE.PointLight(0x33ff00, 1, 30);
        exitLight.position.set(0, 3, 45);
        this.scene.add(exitLight);
    },

    setupEscapeControls() {
        // Keyboard controls
        this.keys = {};
        window.addEventListener('keydown', (e) => {
            this.keys[e.key.toLowerCase()] = true;
        });
        
        window.addEventListener('keyup', (e) => {
            this.keys[e.key.toLowerCase()] = false;
        });
        
        // Mouse look
        let isPointerLocked = false;
        const canvas = this.renderer.domElement;
        
        canvas.addEventListener('click', () => {
            canvas.requestPointerLock();
        });
        
        document.addEventListener('pointerlockchange', () => {
            isPointerLocked = document.pointerLockElement === canvas;
        });
        
        document.addEventListener('mousemove', (e) => {
            if (!isPointerLocked || !this.escapeMode) return;
            
            const sensitivity = 0.002;
            this.playerRotation.y -= e.movementX * sensitivity;
            this.playerRotation.x -= e.movementY * sensitivity;
            this.playerRotation.x = Math.max(-Math.PI/2, Math.min(Math.PI/2, this.playerRotation.x));
        });
    },

    animateEscape() {
        if (!this.escapeMode) return;
        if (!this.renderer || !this.scene || !this.camera) {
            console.warn('Escape mode: renderer/scene/camera not initialized');
            return;
        }
        requestAnimationFrame(() => this.animateEscape());
        
        const speed = 0.15;
        const moveVector = new THREE.Vector3();
        
        // Movement
        if (this.keys['w']) moveVector.z -= 1;
        if (this.keys['s']) moveVector.z += 1;
        if (this.keys['a']) moveVector.x -= 1;
        if (this.keys['d']) moveVector.x += 1;
        
        moveVector.normalize();
        moveVector.multiplyScalar(speed);
        
        // Apply rotation to movement
        const yaw = this.playerRotation.y;
        const rotatedX = moveVector.x * Math.cos(yaw) - moveVector.z * Math.sin(yaw);
        const rotatedZ = moveVector.x * Math.sin(yaw) + moveVector.z * Math.cos(yaw);
        
        this.playerPosition.x += rotatedX;
        this.playerPosition.z += rotatedZ;
        
        // Update camera
        this.camera.position.set(
            this.playerPosition.x,
            this.playerPosition.y,
            this.playerPosition.z
        );
        this.camera.rotation.order = 'YXZ';
        this.camera.rotation.y = this.playerRotation.y;
        this.camera.rotation.x = this.playerRotation.x;
        
        // Check distance to exit
        if (this.exitDoor) {
            const dx = this.playerPosition.x - this.exitDoor.position.x;
            const dz = this.playerPosition.z - this.exitDoor.position.z;
            const distance = Math.sqrt(dx * dx + dz * dz);
            
            const exitDistanceEl = document.getElementById('exit-distance');
            if (exitDistanceEl) {
                exitDistanceEl.textContent = Math.floor(distance);
            }
            
            // Win condition - reach the exit
            if (distance < 2) {
                this.escapeComplete();
            }
        }
        
        // Animate exit door pulsing
        if (this.exitDoor && this.exitDoor.material) {
            const time = Date.now() * 0.003;
            this.exitDoor.material.emissiveIntensity = 2 + Math.sin(time) * 1;
        }
        
        if (this.renderer && this.scene && this.camera) {
            this.renderer.render(this.scene, this.camera);
        }
    },

    escapeComplete() {
        this.escapeMode = false;
        
        // Hide escape UI
        const escapeHud = document.getElementById('escape-hud');
        const escapeInstructions = document.getElementById('escape-instructions');
        if (escapeHud) escapeHud.style.display = 'none';
        if (escapeInstructions) escapeInstructions.style.display = 'none';
        
        // Show victory screen
        const victoryScreen = document.createElement('div');
        victoryScreen.style.cssText = `
            position: fixed;
            inset: 0;
            background: #000;
            z-index: 999999;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: var(--p-green);
        `;
        victoryScreen.innerHTML = `
            <h1 style="font-size:5rem; letter-spacing:15px; margin-bottom:30px;">FREEDOM</h1>
            <p style="font-size:1.5rem; margin-bottom:20px;">You escaped the basement.</p>
            <p style="font-size:1rem; color:var(--p-amber);">Total Survival Time: ${this.winTime} seconds</p>
            <p style="font-size:1rem; margin-top:10px;">High Score: ${GameState.highScore} seconds</p>
            <button class="sys-btn" style="margin-top:40px; font-size:20px; padding:15px 40px;" onclick="location.reload()" onmousedown="SoundManager.playClick()">PLAY AGAIN</button>
        `;
        document.body.appendChild(victoryScreen);
        
        if (typeof SoundManager !== 'undefined' && SoundManager.playSuccess) {
            SoundManager.playSuccess();
            setTimeout(() => {
                for (let i = 0; i < 5; i++) {
                    setTimeout(() => {
                        if (typeof SoundManager !== 'undefined' && SoundManager.playSuccess) {
                            SoundManager.playSuccess();
                        }
                    }, i * 200);
                }
            }, 500);
        }
    },

    fail(reason) {
        this.isLive = false;
        SoundManager.playGameOver();
        
        try {
            const deathReason = document.getElementById('death-reason');
            const finalTime = document.getElementById('final-time');
            const highScore = document.getElementById('high-score');
            const deathScreen = document.getElementById('death-screen');
            
            if (deathReason) deathReason.textContent = reason;
            if (finalTime) finalTime.textContent = GameState.survivalTime;
            
            if (GameState.survivalTime > GameState.highScore) {
                GameState.highScore = GameState.survivalTime;
                try {
                    localStorage.setItem('voidOsHighScore', GameState.highScore);
                } catch (e) {
                    console.warn('Could not save high score to localStorage:', e);
                }
            }
            
            if (highScore) highScore.textContent = GameState.highScore;
            if (deathScreen) deathScreen.style.display = 'flex';
        } catch (error) {
            console.error('Error showing death screen:', error);
        }
    }
};

