// TERMINAL
// =============================================================================

const Terminal = {
    out: null, 
    in: null,
    history: [],
    historyIndex: -1,
    art: [
        "  .      .  ",
        "  |\\____/|  ",
        " (: o  o :) ",
        "  \\  ww  /  ",
        "   '----'   "
    ],

    init() {
        this.out = document.getElementById('term-out');
        this.in = document.getElementById('term-in');
        
        if (!this.out || !this.in) {
            console.warn('Terminal elements not found');
            return;
        }
        
        this.in.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                const cmd = this.in.value.trim();
                if (cmd) {
                    this.history.push(cmd);
                    this.historyIndex = this.history.length;
                    this.print(`> ${cmd}`);
                    this.exec(cmd.toLowerCase());
                }
                this.in.value = '';
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                if (this.historyIndex > 0) {
                    this.historyIndex--;
                    this.in.value = this.history[this.historyIndex];
                }
            } else if (e.key === 'ArrowDown') {
                e.preventDefault();
                if (this.historyIndex < this.history.length - 1) {
                    this.historyIndex++;
                    this.in.value = this.history[this.historyIndex];
                } else {
                    this.historyIndex = this.history.length;
                    this.in.value = '';
                }
            }
        });
    },

    print(msg) {
        if (!this.out) return;
        this.out.innerHTML += "\n" + msg;
        this.out.scrollTop = this.out.scrollHeight;
    },

    exec(cmd) {
        const commands = {
            'help': () => this.print("COMMANDS:\n  scan, clear, status, reboot, boost, recharge, info, stats, pause, shortcuts"),
            'scan': () => {
                this.print("PERIMETER SCAN INITIATED...");
                this.art.forEach(line => this.print(line));
                const dist = typeof World3D !== 'undefined' ? Math.floor(World3D.dist) : 0;
                const combo = typeof GameState !== 'undefined' ? GameState.combo.toFixed(1) : '1.0';
                this.print(`ENTITY AT ${dist}m | COMBO: x${combo}`);
            },
            'clear': () => {
                if (this.out) this.out.innerHTML = "Terminal cleared.";
            },
            'status': () => {
                const power = typeof UI !== 'undefined' ? Math.floor(UI.power) : 0;
                const shield = typeof GameState !== 'undefined' ? Math.floor(GameState.shield) : 0;
                const procCount = typeof UI !== 'undefined' ? UI.openApps.size : 0;
                const dist = typeof World3D !== 'undefined' ? Math.floor(World3D.dist) : 0;
                const time = typeof GameState !== 'undefined' ? GameState.survivalTime : 0;
                const combo = typeof GameState !== 'undefined' ? GameState.combo.toFixed(1) : '1.0';
                this.print(`BATTERY: ${power}% | SHIELD: ${shield}%`);
                this.print(`ACTIVE_PROC: ${procCount} | ENTITY: ${dist}m`);
                this.print(`SURVIVED: ${time}s | COMBO: x${combo}`);
            },
            'reboot': () => location.reload(),
            'boost': () => {
                if (typeof UI === 'undefined' || typeof World3D === 'undefined') {
                    this.print("ERROR: SYSTEM NOT INITIALIZED");
                    SoundManager.playError();
                    return;
                }
                if (UI.power >= 20) {
                    World3D.pushBack(15);
                    UI.power -= 20;
                    this.print("EMERGENCY REPULSOR ACTIVATED. -20% BATTERY");
                    SoundManager.playPowerup();
                } else {
                    this.print("ERROR: INSUFFICIENT POWER (20% REQUIRED)");
                    SoundManager.playError();
                }
            },
            'recharge': () => {
                if (typeof UI === 'undefined' || typeof World3D === 'undefined') {
                    this.print("ERROR: SYSTEM NOT INITIALIZED");
                    SoundManager.playError();
                    return;
                }
                if (UI.power < 100) {
                    UI.power = Math.min(100, UI.power + 25);
                    World3D.dist = Math.max(1, World3D.dist - 5);
                    this.print("BATTERY RECHARGED +25%. ENTITY ADVANCED 5m.");
                    SoundManager.playSuccess();
                } else {
                    this.print("BATTERY ALREADY AT FULL CAPACITY");
                    SoundManager.playBeep(400, 0.1);
                }
            },
            'info': () => {
                this.print("VOID_OS KERNEL v26.0 ULTIMATE");
                this.print("Enhanced survival mechanics with combo system.");
                this.print("Build combos by playing games. Shield protects from entity.");
            },
            'stats': () => {
                const highScore = typeof GameState !== 'undefined' ? GameState.highScore : 0;
                const achievements = typeof GameState !== 'undefined' ? GameState.achievements.size : 0;
                const time = typeof GameState !== 'undefined' ? GameState.survivalTime : 0;
                this.print(`HIGH SCORE: ${highScore}s`);
                this.print(`ACHIEVEMENTS: ${achievements} unlocked`);
                this.print(`CURRENT RUN: ${time}s`);
            },
            'pause': () => {
                if (typeof Snake !== 'undefined' && Snake.isRunning) Snake.togglePause();
                if (typeof Pong !== 'undefined' && Pong.isRunning) Pong.togglePause();
                if (typeof Dodge !== 'undefined' && Dodge.isRunning) Dodge.togglePause();
                this.print("GAMES PAUSED/UNPAUSED");
            },
            'shortcuts': () => {
                this.print("KEYBOARD SHORTCUTS:");
                this.print("  Ctrl+1: Toggle Snake");
                this.print("  Ctrl+2: Toggle Pong");
                this.print("  Ctrl+3: Toggle Dodge");
                this.print("  Ctrl+T: Toggle Terminal");
                this.print("  Space: Pause/Unpause active game");
                this.print("  ESC: Close popups / Pause all");
            }
        };

        if (commands[cmd]) {
            commands[cmd]();
        } else {
            this.print(`ERROR: '${cmd}' not recognized. Type 'help'.`);
        }
    }
};

